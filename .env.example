# Copy this file to `.env` in the repository root and fill in the values:
#
#   cp .env.example .env
#
# `.env` is ignored by git and must never be committed. This file, with the
# placeholders, is the one that is committed.
#
# A variable set in the shell wins over the same variable in this file, so you
# can override one value for a single run without editing anything:
#
#   CONNECTOR_ACCESS_TOKEN=another-one npm run record -- dropbox

# ---------------------------------------------------------------------------
# 1. The package token — you need this one to install anything
# ---------------------------------------------------------------------------
# Available at https://collaborators.vinovalab.ai, in the details of your
# challenge. It needs `read:packages`.
#
# @vinovalab/storage-connector-contract is published to GitHub Packages and not
# to the public registry, so without this token `npm install` fails with a 401.
#
# **npm does not read this file.** Two ways to make it work, pick one:
#
#   a) paste the token straight into `.npmrc` — see `.npmrc.example`. Nothing
#      else to remember, and it is the shorter road.
#
#   b) keep it here and export it before installing, which is what you want when
#      the same value also has to reach a Docker build or a CI job:
#
#        set -a; . ./.env; set +a
#        npm install
#
# If `.npmrc` says `${NODE_AUTH_TOKEN}` and the variable is not exported, npm
# does not complain: it sends the literal text `${NODE_AUTH_TOKEN}` to the
# registry and you get a 401 that looks like a bad token rather than a missing
# variable.
NODE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Everything below is needed only by `npm run record`
# ---------------------------------------------------------------------------
# Not for the test suite and not for the Connection Test page: those two run
# against recorded fixtures, with no account and no network. These values are
# needed only to produce fixtures in the first place, and `npm run record` reads
# them from this file on its own.

# ---------------------------------------------------------------------------
# 2. The account being recorded
# ---------------------------------------------------------------------------
# Tokens for the test account prepared as the connector's `scenario.js`
# describes. They belong to whichever provider you are recording, one at a time.
CONNECTOR_ACCESS_TOKEN=
CONNECTOR_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# 3. Dropbox — https://www.dropbox.com/developers/apps
# ---------------------------------------------------------------------------
# App key and App secret are on the app's Settings tab; the redirect URI is the
# one registered under OAuth 2. The authorisation must use
# `token_access_type=offline`, otherwise Dropbox issues no refresh token and the
# connection dies after four hours.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:5190/oauth/dropbox/callback

# ---------------------------------------------------------------------------
# 4. Google Drive — https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
# Client ID and secret of an OAuth 2.0 Client ID of type "Web application"; the
# redirect URI must be listed among that client's authorised redirect URIs. The
# authorisation needs `access_type=offline` **and** `prompt=consent`: without the
# second one a repeat connection gets no refresh token and synchronisation dies
# after an hour.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5190/oauth/google-drive/callback
